# Copy to .env for scripts/dev-run.sh. Never commit .env or signing keys.
# This file is sourced as shell code; use only configuration you trust.
RELAY_ADDR=127.0.0.1:8080
APNS_ENABLED=false
RELAY_ALLOW_LEGACY_SEND=false
RUST_LOG=info

# APNS is optional. Configure your own team, topic, key ID, and external key
# path using the variables in README.md; there are no bundled credentials.
