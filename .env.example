# Local development: copy to .env, customize, then run ./scripts/dev-run.sh.
# The script sources .env with set -a to export assignments to the relay.
# Use only a file you trust: .env is shell code. Never commit it or signing keys.
# The binary reads process environment variables; it does not load .env itself.

# Loopback is safer for development; the built-in default is 0.0.0.0:8080.
RELAY_ADDR=127.0.0.1:8080
# Active upgraded WebSockets (1 through 65536).
RELAY_MAX_CONNECTIONS=1024
# Queue lifetime, decoded envelope size, and per-recipient message count.
RELAY_MESSAGE_TTL=168h
RELAY_MAX_MESSAGE_BYTES=65536
RELAY_MAX_QUEUE_PER_RECIPIENT=500
# Global queued-byte budget including bookkeeping (256 MiB).
RELAY_MAX_TOTAL_QUEUED_BYTES=268435456
# Maximum buffered outbound frames per WebSocket.
RELAY_MAX_SESSION_SEND_QUEUE=128
# Authentication challenge and authenticated session lifetimes.
RELAY_CHALLENGE_TTL=30s
RELAY_SESSION_TTL=24h
# Requests per minute per identity or unauthenticated connection.
RELAY_RATE_LIMIT_PER_MIN=60
# Positive heartbeat durations; pong timeout must be at least ping interval.
RELAY_PING_INTERVAL=25s
RELAY_PONG_TIMEOUT=60s
# Pending authentication challenges and stored push registrations.
RELAY_MAX_CHALLENGES=10000
RELAY_MAX_PUSH_REGISTRATIONS=100000
# Push registration lifetime.
RELAY_PUSH_TOKEN_TTL=720h
# Keep sends on separate unauthenticated connections unless supporting old clients.
RELAY_ALLOW_LEGACY_SEND=false

# Logging is read in main.rs; this filter makes startup logs visible.
RUST_LOG=pigeon_relay=info

# Push is disabled until real credentials and topics are configured.
APNS_ENABLED=false
APNS_TEAM_ID=YOUR_TEAM_ID
# Generic credentials are the fallback for both APNS environments.
APNS_KEY_ID=YOUR_KEY_ID
APNS_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
# Optional environment-specific overrides: uncomment each ID/path pair together.
# APNS_SANDBOX_KEY_ID=YOUR_SANDBOX_KEY_ID
# APNS_SANDBOX_PRIVATE_KEY_PATH=/path/to/AuthKey_SANDBOX.p8
# APNS_PRODUCTION_KEY_ID=YOUR_PRODUCTION_KEY_ID
# APNS_PRODUCTION_PRIVATE_KEY_PATH=/path/to/AuthKey_PRODUCTION.p8
# Default bundle ID, also allowed for explicit registrations.
APNS_TOPIC=com.example.pigeon
# Optional additional bundle IDs, comma-separated; empty entries are ignored.
APNS_ALLOWED_TOPICS=
# sandbox for Xcode debug installs; production for TestFlight/App Store.
APNS_ENV=sandbox
